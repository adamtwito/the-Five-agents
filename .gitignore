# Claude Code - local-only settings (per-developer permissions)
.claude/settings.local.json

# Environment variables - actual secrets, never commit
.env
.env.local
.env.*.local

# Output artifacts - generated content, do not track
Output/*
!Output/.gitkeep

# Yuval's generated images - PNGs are large binaries, regenerable from sidecar .txt prompts.
# Track .txt prompts (small, useful for iteration); ignore PNGs.
yuval/outputs/*.png
