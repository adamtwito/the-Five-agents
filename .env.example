# ============================================================
# .env.example - תבנית למשתני סביבה
# ============================================================
# העתק את הקובץ הזה ל-.env ומלא את הערכים האמיתיים:
#     cp .env.example .env
#
# חשוב: הקובץ .env נמצא ב-.gitignore ולא יעלה ל-GitHub.
#       אסור להוסיף כאן מפתחות אמיתיים - רק placeholders.
# ============================================================


# ----- כללי -----
# ANTHROPIC_API_KEY: רק אם הסוכנים קוראים ישירות ל-Anthropic API
# (לא נדרש אם אתה מפעיל אותם דרך Claude Code).
ANTHROPIC_API_KEY=


# ----- יעל (כותבת התוכן) -----
# כאן יבואו מפתחות לכלי כתיבה/עריכה אם יידרשו.


# ----- יובל (מעצב התמונות) -----
# מפתחות לשירותי יצירת תמונות (לדוגמה: OpenAI DALL-E, Stability AI, Replicate).
# OPENAI_API_KEY=
# STABILITY_API_KEY=
# REPLICATE_API_TOKEN=


# ----- חן (החוקרת) -----
# מפתחות לשירותי חיפוש ומחקר באינטרנט.
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=
# PERPLEXITY_API_KEY=
